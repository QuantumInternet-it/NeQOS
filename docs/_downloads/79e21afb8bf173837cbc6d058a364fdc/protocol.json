{
  "protocolId": "ReadChannelDelays",
  "description": "Read the live temporal input-delay settings of selected Time Tagger channels.",
  "domain": "timing",
  "function": "alignment",
  "status": "production",
  "exported": true,
  "privilegeLevel": "NORMAL",
  "dependencies": [],
  "executionMode": "foreground",
  "preemptive": false,
  "timeoutSec": 120.0,
  "resourceRequests": [
    "$shared.timeTaggerDeviceId"
  ],
  "sharedParams": {
    "timeTaggerDeviceId": null,
    "channels": null
  },
  "inputSchema": {
    "schemaVersion": "0.1",
    "parameters": {
      "timeTaggerDeviceId": {
        "type": "string",
        "description": "Identifier of the Time Tagger whose live channel delays are read.",
        "required": true,
        "minLength": 1
      },
      "channels": {
        "type": "array",
        "description": "Physical Time Tagger channels whose current input delays are read.",
        "required": true,
        "minItems": 1,
        "items": {
          "type": "integer",
          "description": "Physical Time Tagger channel number.",
          "minimum": 1
        }
      }
    }
  },
  "outputSchema": {
    "schemaVersion": "0.1",
    "exports": {
      "timing.alignment.observation.channelDelays": {
        "type": "object",
        "description": "Live Time Tagger channel input delays returned by device read-back.",
        "role": "observation"
      }
    }
  },
  "stages": [
    {
      "stageId": "00-ReadChannelDelays",
      "handler": "ReadChannelDelaysStage",
      "params": {
        "timeTaggerDeviceId": "$shared.timeTaggerDeviceId",
        "channels": "$shared.channels"
      }
    },
    {
      "stageId": "01-ReadChannelDelays-PublishResult",
      "handler": "PublishResultStage",
      "params": {
        "exports": [
          {
            "from": "readChannelDelays",
            "as": "timing.alignment.observation.channelDelays"
          }
        ]
      }
    }
  ]
}
