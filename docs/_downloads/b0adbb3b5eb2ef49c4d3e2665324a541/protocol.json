{
  "protocolId": "HOLD-STATIC",
  "summary": "Compose a hold using declared submit and wait stages.",
  "description": "Submit HoldDuration, import its public result and publish it from this parent.",
  "privilegeLevel": "NORMAL",
  "dependencies": [],
  "executionMode": "foreground",
  "preemptive": false,
  "timeoutSec": 30,
  "resourceRequests": [],
  "sharedParams": {
    "durationSec": 0.1
  },
  "inputSchema": {
    "schemaVersion": "0.1",
    "parameters": {
      "durationSec": {
        "type": "number",
        "description": "Duration of the child hold, in seconds.",
        "required": true,
        "minimum": 0,
        "maximum": 10
      }
    }
  },
  "outputSchema": {
    "schemaVersion": "0.1",
    "exports": {
      "execution.control.status.holdDuration": {
        "type": "object",
        "description": "Completed child hold and its timestamps.",
        "role": "status"
      }
    }
  },
  "stages": [
    {
      "stageId": "00-Submit",
      "handler": "SubmitMicroProtocolStage",
      "params": {
        "templateId": "HoldDuration",
        "protocolKey": "hold",
        "sharedParamOverrides": {
          "durationSec": "$shared.durationSec"
        }
      }
    },
    {
      "stageId": "01-Wait",
      "handler": "WaitMicroProtocolStage",
      "params": {
        "protocolKey": "hold",
        "pollDelaySec": 0.05,
        "imports": [
          {
            "from": "execution.control.status.holdDuration",
            "as": "holdResult"
          }
        ]
      }
    },
    {
      "stageId": "02-Publish",
      "handler": "PublishResultStage",
      "params": {
        "exports": [
          {
            "from": "holdResult",
            "as": "execution.control.status.holdDuration"
          }
        ],
        "writeSummary": true
      }
    }
  ]
}
