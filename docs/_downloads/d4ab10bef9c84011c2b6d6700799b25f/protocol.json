{
  "protocolId": "MPC320CountsMaximization",
  "description": "Open IEEE QCE demonstration wrapper for aligning the polarization incident on the SNSPD of one selected quantum link.",
  "privilegeLevel": "NORMAL",
  "dependencies": [],
  "executionMode": "foreground",
  "preemptive": false,
  "timeoutSec": 3600.0,
  "resourceRequests": [],
  "sharedParams": {
    "linkId": null,
    "resourceDeviceIds": null,
    "measurementDurationSec": 2.0,
    "optimizationMode": "maximize",
    "paddles": [
      0,
      1,
      2
    ],
    "initialAnglesDeg": [
      0.0,
      0.0,
      0.0
    ],
    "finalAnglesDeg": [
      160.0,
      160.0,
      160.0
    ],
    "stepDeg": 20.0,
    "settleAfterMoveSec": 0.2,
    "moveTimeoutSec": 30.0
  },
  "inputSchema": {
    "schemaVersion": "0.1",
    "parameters": {
      "linkId": {
        "type": "string",
        "description": "Quantum link whose SNSPD input polarization is aligned.",
        "required": true,
        "minLength": 1
      },
      "resourceDeviceIds": {
        "type": "array",
        "description": "MPC320 and TimeTagger identifiers reserved by the protected child.",
        "required": true,
        "minItems": 2
      },
      "measurementDurationSec": {
        "type": "number",
        "description": "Integration duration of each count sample, in seconds.",
        "required": false,
        "minimum": 0
      },
      "optimizationMode": {
        "type": "string",
        "description": "Whether the child maximizes or minimizes the SNSPD count rate.",
        "required": false,
        "enum": [
          "maximize",
          "minimize"
        ]
      },
      "paddles": {
        "type": "array",
        "description": "MPC320 paddle indices to scan.",
        "required": true,
        "minItems": 1
      },
      "initialAnglesDeg": {
        "type": "array",
        "description": "Initial angle per paddle, in degrees.",
        "required": true,
        "minItems": 1
      },
      "finalAnglesDeg": {
        "type": "array",
        "description": "Final angle per paddle, in degrees.",
        "required": true,
        "minItems": 1
      },
      "stepDeg": {
        "type": "number",
        "description": "Coarse angular scan increment in degrees.",
        "required": true,
        "minimum": 0.000001
      },
      "settleAfterMoveSec": {
        "type": "number",
        "description": "Settling delay after each movement, in seconds.",
        "required": false,
        "minimum": 0
      },
      "moveTimeoutSec": {
        "type": "number",
        "description": "Timeout per controller movement, in seconds.",
        "required": false,
        "minimum": 0
      }
    }
  },
  "outputSchema": {
    "schemaVersion": "0.1",
    "exports": {
      "link.polarizationAlignment.status.alignment": {
        "type": "object",
        "description": "Terminal alignment status and resolved target.",
        "role": "status"
      },
      "link.polarizationAlignment.applied.selectedControllerAnglesDeg": {
        "type": "array",
        "description": "Selected MPC320 angles, in paddle order.",
        "role": "applied"
      },
      "link.polarizationAlignment.observation.countSamples": {
        "type": "array",
        "description": "Count samples collected by the alignment scan.",
        "role": "observation"
      }
    }
  },
  "stages": [
    {
      "stageId": "00-AlignSNSPDInputPolarization",
      "handler": "SubmitMicroProtocolStage",
      "params": {
        "templateId": "AlignSNSPDInputPolarization",
        "protocolKey": "alignment",
        "sharedParamOverrides": {
          "linkId": "$shared.linkId",
          "resourceDeviceIds": "$shared.resourceDeviceIds",
          "measurementDurationSec": "$shared.measurementDurationSec",
          "clear": true,
          "optimizationMode": "$shared.optimizationMode",
          "paddles": "$shared.paddles",
          "initialAnglesDeg": "$shared.initialAnglesDeg",
          "finalAnglesDeg": "$shared.finalAnglesDeg",
          "stepDeg": "$shared.stepDeg",
          "settleAfterMoveSec": "$shared.settleAfterMoveSec",
          "moveTimeoutSec": "$shared.moveTimeoutSec"
        }
      }
    },
    {
      "stageId": "01-WaitForSNSPDInputPolarizationAlignment",
      "handler": "WaitMicroProtocolStage",
      "params": {
        "templateId": "AlignSNSPDInputPolarization",
        "protocolKey": "alignment",
        "imports": [
          {
            "from": "link.polarizationAlignment.status.alignment",
            "as": "alignment.status"
          },
          {
            "from": "link.polarizationAlignment.applied.selectedControllerAnglesDeg",
            "as": "alignment.selectedControllerAnglesDeg"
          },
          {
            "from": "link.polarizationAlignment.observation.countSamples",
            "as": "alignment.countSamples"
          }
        ]
      }
    },
    {
      "stageId": "02-MPC320CountsMaximization-PublishResult",
      "handler": "PublishResultStage",
      "params": {
        "exports": [
          {
            "from": "alignment.status",
            "as": "link.polarizationAlignment.status.alignment"
          },
          {
            "from": "alignment.selectedControllerAnglesDeg",
            "as": "link.polarizationAlignment.applied.selectedControllerAnglesDeg"
          },
          {
            "from": "alignment.countSamples",
            "as": "link.polarizationAlignment.observation.countSamples"
          }
        ]
      }
    }
  ]
}
