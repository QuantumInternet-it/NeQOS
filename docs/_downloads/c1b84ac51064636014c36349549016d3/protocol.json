{
  "protocolId": "MeasureEntangledPairFidelity",
  "description": "Measures Phi+ lab-frame fidelity, the fully entangled fraction, and their fidelity gap from guarded entangled-pair tomography of the current optical state without configuring or compensating the source.",
  "domain": "entanglement",
  "function": "fidelity",
  "status": "production",
  "exported": true,
  "privilegeLevel": "NORMAL",
  "dependencies": [],
  "executionMode": "foreground",
  "preemptive": false,
  "timeoutSec": 7200,
  "resourceRequests": [
    "$shared.resourceDeviceIds"
  ],
  "sharedParams": {
    "linkPairIds": null,
    "polarizationAnalyzerDeviceIds": null,
    "resourceDeviceIds": null,
    "measurementDurationSec": 10,
    "settleSec": 1,
    "coincidenceWindowPs": 1000,
    "useCompensatedTomoStates": true,
    "backgroundCountRateHz": 0,
    "clear": true,
    "latchGuard": null,
    "qualityGate": null,
    "maxReconstructionIterations": 5000,
    "numericLocalUnitaryRestarts": 20,
    "numericLocalUnitarySeed": null,
    "dwdmChannelByLink": {},
    "defaultDwdmChannel": null,
    "useCompensatedTomoStatesByLink": {}
  },
  "inputSchema": {
    "schemaVersion": "0.1",
    "parameters": {
      "linkPairIds": {
        "type": "array",
        "description": "Exactly two emitted entangled-pair link identifiers defining the row and column analyzers.",
        "required": true,
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "string",
          "description": "One link identifier resolved from network.json.",
          "required": true,
          "minLength": 1
        }
      },
      "polarizationAnalyzerDeviceIds": {
        "type": "array",
        "description": "Exact analyzer-device lease union for the selected two link arms.",
        "required": true,
        "minItems": 1,
        "items": {
          "type": "string",
          "description": "One polarization-analyzer device identifier.",
          "required": true,
          "minLength": 1
        }
      },
      "resourceDeviceIds": {
        "type": "array",
        "description": "Exact union of the TimeTagger, selected analyzers, and detector-health devices required for the complete guarded tomography matrix.",
        "required": true,
        "minItems": 3,
        "items": {
          "type": "string",
          "description": "One device held for the complete measurement workflow.",
          "required": true,
          "minLength": 1
        }
      },
      "measurementDurationSec": {
        "type": "number",
        "description": "Finite integration duration for each topology-derived physical coincidence acquisition.",
        "required": false,
        "minimum": 0.000001
      },
      "settleSec": {
        "type": "number",
        "description": "Delay after each analyzer-state change before its finite coincidence window.",
        "required": false,
        "minimum": 0
      },
      "coincidenceWindowPs": {
        "type": "integer",
        "description": "AND coincidence window in picoseconds.",
        "required": false,
        "minimum": 1
      },
      "useCompensatedTomoStates": {
        "type": "boolean",
        "description": "Use installed or loaded analyzer compensation tables. False uses factory tomography states and does not require a table.",
        "required": false
      },
      "backgroundCountRateHz": {
        "type": "number",
        "description": "Coincidence background rate subtracted from every projection before reconstruction.",
        "required": false,
        "minimum": 0
      },
      "clear": {
        "type": "boolean",
        "description": "Must be true because required latch protection retries an invalid window as a fresh integration.",
        "required": false
      },
      "latchGuard": {
        "type": "object",
        "description": "Required per-window detector-latch policy passed unchanged to the guarded 6x6 observation child.",
        "required": true,
        "properties": {
          "mode": {
            "type": "string",
            "description": "Finite pair tomography always requires detector-latch protection.",
            "required": true,
            "enum": [
              "required"
            ]
          },
          "maxWindowRetries": {
            "type": "integer",
            "description": "Maximum immediate retries after a recovered latch-invalid child window.",
            "required": true,
            "minimum": 0
          }
        }
      },
      "qualityGate": {
        "type": "object",
        "description": "Explicit matrix acceptance policy applied before density reconstruction and fidelity estimation.",
        "required": true,
        "properties": {
          "minimumCompleteBasisCounts": {
            "type": "number",
            "description": "Minimum corrected total over each complete four-outcome basis pair.",
            "required": true,
            "minimum": 0
          },
          "maximumBasisRateRelativeStandardDeviation": {
            "type": "number",
            "description": "Maximum allowed relative rate variation across complete basis settings.",
            "required": true,
            "minimum": 0
          }
        }
      },
      "maxReconstructionIterations": {
        "type": "integer",
        "description": "Maximum maximum-likelihood density-reconstruction iterations.",
        "required": false,
        "minimum": 1
      },
      "numericLocalUnitaryRestarts": {
        "type": "integer",
        "description": "Random restarts for the independent numerical local-unitary Phi+ diagnostic.",
        "required": false,
        "minimum": 0
      },
      "numericLocalUnitarySeed": {
        "type": "integer",
        "description": "Optional deterministic seed for the numerical local-unitary diagnostic.",
        "required": false
      },
      "dwdmChannelByLink": {
        "type": "object",
        "description": "Optional per-link DWDM channel overrides for analyzer preparation.",
        "required": false
      },
      "defaultDwdmChannel": {
        "type": "integer",
        "description": "Optional fallback DWDM channel when a selected link omits one in network.json.",
        "required": false,
        "minimum": 1
      },
      "useCompensatedTomoStatesByLink": {
        "type": "object",
        "description": "Optional exact map of both linkIds to boolean table policies. A nonempty map overrides useCompensatedTomoStates, allowing a factory reference and compensated target without changing either policy implicitly.",
        "required": false
      }
    }
  },
  "outputSchema": {
    "schemaVersion": "0.1",
    "exports": {
      "entanglement.fidelity.estimate.entangledPairFidelity": {
        "type": "object",
        "description": "Report from EstimateEntangledPairFidelity: labFrameFidelity is Phi+ fidelity in the current laboratory frame; fullyEntangledFraction is the SVD optimum over local unitary frames; frameMisalignmentFidelityLoss is their dimensionless difference, ideally recoverable by local unitary compensation. Independent numerical optimization appears only under crossCheck, with no delta field. These metrics do not imply any physical correction or identify whether a deficit originates in source, channel, or measurement. Null when quality assessment is rejected or malformed and no fidelity is computed.",
        "role": "estimate"
      },
      "entanglement.fidelity.status.tomographyAcceptance": {
        "type": "object",
        "description": "Parent acceptance decision, rejection reasons, and references to the validator's runtime, result, and quality report. Published before failure when tomography is rejected; no fidelity estimate is calculated in that case.",
        "role": "status"
      },
      "entanglement.fidelity.artifact.densityMatrixPlots": {
        "type": "object",
        "description": "PNG/SVG paths for labFrame and the theoretical svdFrame, produced once by the fidelity-estimation child and re-exported unchanged; empty when quality rejection prevents estimation.",
        "role": "artifact"
      }
    }
  },
  "stages": [
    {
      "stageId": "00-MeasureEntangledPairPolarizationCoincidences",
      "handler": "SubmitMicroProtocolStage",
      "params": {
        "templateId": "MeasureEntangledPairPolarizationCoincidences",
        "protocolKey": "entangledPairTomography",
        "sharedParamOverrides": {
          "linkPairIds": "$shared.linkPairIds",
          "polarizationAnalyzerDeviceIds": "$shared.polarizationAnalyzerDeviceIds",
          "resourceDeviceIds": "$shared.resourceDeviceIds",
          "measurementDurationSec": "$shared.measurementDurationSec",
          "settleSec": "$shared.settleSec",
          "coincidenceWindowPs": "$shared.coincidenceWindowPs",
          "useCompensatedTomoStates": "$shared.useCompensatedTomoStates",
          "backgroundCountRateHz": "$shared.backgroundCountRateHz",
          "clear": "$shared.clear",
          "latchGuard": "$shared.latchGuard",
          "dwdmChannelByLink": "$shared.dwdmChannelByLink",
          "defaultDwdmChannel": "$shared.defaultDwdmChannel",
          "useCompensatedTomoStatesByLink": "$shared.useCompensatedTomoStatesByLink"
        }
      }
    },
    {
      "stageId": "01-MeasureEntangledPairPolarizationCoincidences",
      "handler": "WaitMicroProtocolStage",
      "params": {
        "templateId": "MeasureEntangledPairPolarizationCoincidences",
        "protocolKey": "entangledPairTomography",
        "pollDelaySec": 0.1,
        "imports": [
          {
            "from": "link.characterization.observation.entangledPairPolarizationCoincidences",
            "as": "entangledPairPolarizationTomography"
          }
        ]
      }
    },
    {
      "stageId": "02-ValidateEntangledPairPolarizationTomography",
      "handler": "SubmitMicroProtocolStage",
      "params": {
        "templateId": "ValidateEntangledPairPolarizationTomography",
        "protocolKey": "tomographyQuality",
        "sharedParamOverrides": {
          "entangledPairPolarizationTomography": "$scratch.entangledPairPolarizationTomography",
          "qualityGate": "$shared.qualityGate"
        }
      }
    },
    {
      "stageId": "03-ValidateEntangledPairPolarizationTomography",
      "handler": "WaitMicroProtocolStage",
      "params": {
        "templateId": "ValidateEntangledPairPolarizationTomography",
        "protocolKey": "tomographyQuality",
        "pollDelaySec": 0.1,
        "imports": [
          {
            "from": "link.characterization.status.entangledPairPolarizationTomographyQuality",
            "as": "entangledPairTomographyQuality"
          }
        ]
      }
    },
    {
      "stageId": "04-RequireAcceptedEntangledPairTomographyQuality",
      "handler": "RequireAcceptedEntangledPairTomographyQualityStage",
      "params": {
        "quality": "$scratch.entangledPairTomographyQuality"
      }
    },
    {
      "stageId": "05-ReconstructTwoQubitDensityMatrix",
      "handler": "SubmitMicroProtocolStage",
      "params": {
        "templateId": "ReconstructTwoQubitDensityMatrix",
        "protocolKey": "densityMatrix",
        "sharedParamOverrides": {
          "entangledPairPolarizationTomography": "$scratch.entangledPairPolarizationTomography",
          "maxIterations": "$shared.maxReconstructionIterations"
        }
      }
    },
    {
      "stageId": "06-ReconstructTwoQubitDensityMatrix",
      "handler": "WaitMicroProtocolStage",
      "params": {
        "templateId": "ReconstructTwoQubitDensityMatrix",
        "protocolKey": "densityMatrix",
        "pollDelaySec": 0.1,
        "imports": [
          {
            "from": "tomography.state.estimate.twoQubitDensityMatrix",
            "as": "twoQubitDensityMatrix"
          }
        ]
      }
    },
    {
      "stageId": "07-EstimateEntangledPairFidelity",
      "handler": "SubmitMicroProtocolStage",
      "params": {
        "templateId": "EstimateEntangledPairFidelity",
        "protocolKey": "fidelity",
        "sharedParamOverrides": {
          "twoQubitDensityMatrix": "$scratch.twoQubitDensityMatrix",
          "numericLocalUnitaryRestarts": "$shared.numericLocalUnitaryRestarts",
          "numericLocalUnitarySeed": "$shared.numericLocalUnitarySeed"
        }
      }
    },
    {
      "stageId": "08-EstimateEntangledPairFidelity",
      "handler": "WaitMicroProtocolStage",
      "params": {
        "templateId": "EstimateEntangledPairFidelity",
        "protocolKey": "fidelity",
        "pollDelaySec": 0.1,
        "imports": [
          {
            "from": "entanglement.fidelity.estimate.entangledPairFidelity",
            "as": "entangledPairFidelity"
          },
          {
            "from": "entanglement.fidelity.artifact.densityMatrixPlots",
            "as": "entangledPairFidelityPlots"
          }
        ]
      }
    },
    {
      "stageId": "09-MeasureEntangledPairFidelity-PublishResult",
      "handler": "PublishResultStage",
      "params": {
        "exports": [
          {
            "from": "entangledPairFidelity",
            "as": "entanglement.fidelity.estimate.entangledPairFidelity"
          },
          {
            "from": "entangledPairTomographyAcceptance",
            "as": "entanglement.fidelity.status.tomographyAcceptance"
          },
          {
            "from": "entangledPairFidelityPlots",
            "as": "entanglement.fidelity.artifact.densityMatrixPlots"
          }
        ]
      }
    }
  ]
}
